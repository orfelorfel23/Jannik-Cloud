#!/usr/bin/env bash
# Mind-o-Mat Service-Init (idempotent, wird von deploy_script.sh aufgerufen)
# Wird bei jedem Deploy ausgefuehrt, ueberspringt bereits initialisierte Teile

set -euo pipefail

SVC_DIR="$(cd "$(dirname "$0")" && pwd)"
VAULT_DIR="/mnt/Jannik-Cloud-Volume-01/mindomat-vault"

echo "==========================================="
echo " Mind-o-Mat Service Init"
echo "==========================================="

# 1. Vault-Verzeichnis anlegen (idempotent)
if [[ ! -d "${VAULT_DIR}" ]]; then
    echo "[1/3] Initialisiere Vault..."
    mkdir -p "${VAULT_DIR}"
    # 12 Standardordner
    for d in "00_Inbox" "00_Inbox/Verarbeitet" "00_Inbox/Problemfaelle" \
             "01_Daily" "10_Wiki" "10_Wiki/Seiten" "20_Projekte" \
             "90_Templates" "99_System" "99_System/Skripte" \
             "99_System/Logs" "99_System/Cache"; do
        mkdir -p "${VAULT_DIR}/$d"
    done
    # Konfig.md (mit Standardwerten)
    if [[ ! -f "${VAULT_DIR}/99_System/Konfig.md" ]]; then
        cat > "${VAULT_DIR}/99_System/Konfig.md" <<'EOF'
---
veraltet_schwellwert_monate: 12
token_budget_default: 4000
token_budget_hardcap: false
qmd_cache_pfad: 99_System/Cache
sync_remote: https://git.orfel.de/Jannik/Mind-o-Mat-Vault.git
ki_provider: minimax
ki_modell: MiniMax-M3
ki_api_url: https://api.minimaxi.chat/v1
ki_api_key_env: MINIMAX_API_KEY
---
EOF
    fi
    # git init (idempotent)
    if [[ ! -d "${VAULT_DIR}/.git" ]]; then
        cd "${VAULT_DIR}"
        git init -b main
        git add -A
        git -c user.email=mindomat@orfel.de -c user.name=Mindomat commit -m "Initial: Vault-Struktur"
    fi
    echo "      Vault initialisiert: $VAULT_DIR"
else
    echo "[1/3] Vault existiert bereits, ueberspringe"
fi

# 2. QMD-Collections einrichten (manuell, wenn gewuenscht)
# Dies wird vom Container beim ersten Start automatisch versucht,
# aber wir koennen es auch hier vorab machen, falls qmd im PATH ist
if command -v qmd &>/dev/null && [[ -d "${VAULT_DIR}/00_Inbox" ]]; then
    echo "[2/3] QMD-Collections (falls qmd im PATH)..."
    if ! qmd collection list 2>/dev/null | grep -q inbox; then
        qmd collection add "${VAULT_DIR}/00_Inbox" --name inbox 2>/dev/null || true
        qmd collection add "${VAULT_DIR}/01_Daily" --name daily 2>/dev/null || true
        qmd collection add "${VAULT_DIR}/10_Wiki" --name wiki 2>/dev/null || true
        qmd collection add "${VAULT_DIR}/20_Projekte" --name projekte 2>/dev/null || true
    fi
else
    echo "[2/3] QMD-Collections werden im Container beim ersten Start eingerichtet"
fi

# 3. service.enabled sicherstellen
touch "${SVC_DIR}/service.enabled"

echo "==========================================="
echo " Mind-o-Mat Init completed"
echo "==========================================="

#!/usr/bin/env bash
# Mind-o-Mat Service-Init (idempotent, wird von deploy_script.sh aufgerufen)

export GIT_TERMINAL_PROMPT=0

SVC_DIR="$(cd "$(dirname "$0")" && pwd)"
VAULT_DIR="/mnt/Jannik-Cloud-Volume-01/mindomat-vault"
VAULT_REPO_URL="https://git.orfel.de/Jannik/Mind-o-Mat-Vault.git"

echo "==========================================="
echo " Mind-o-Mat Service Init"
echo "==========================================="

# Lese VAULT_SYNC_TOKEN aus Environment oder .env falls vorhanden
VAULT_SYNC_TOKEN="${VAULT_SYNC_TOKEN:-}"
if [[ -z "${VAULT_SYNC_TOKEN}" && -f "${SVC_DIR}/.env" ]]; then
    VAULT_SYNC_TOKEN=$(grep -E "^VAULT_SYNC_TOKEN=" "${SVC_DIR}/.env" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]"' || true)
fi

AUTH_REPO_URL="${VAULT_REPO_URL}"
if [[ -n "${VAULT_SYNC_TOKEN}" ]]; then
    AUTH_REPO_URL="https://oauth2:${VAULT_SYNC_TOKEN}@git.orfel.de/Jannik/Mind-o-Mat-Vault.git"
fi

if ! git config --global --get-all safe.directory 2>/dev/null | grep -qFx "${VAULT_DIR}"; then
    git config --global --add safe.directory "${VAULT_DIR}" 2>/dev/null || true
fi

# 1. Erreichbarkeit von Gitea prüfen (Gitea / Caddy brauchen nach dem Start oft ein paar Sekunden)
GITEA_READY=false
if [[ -n "${VAULT_SYNC_TOKEN}" ]]; then
    MAX_RETRIES=10
    COUNT=0
    LAST_ERROR=""
    while [[ ${COUNT} -lt ${MAX_RETRIES} ]]; do
        COUNT=$((COUNT + 1))
        if LAST_ERROR=$(git ls-remote "${AUTH_REPO_URL}" 2>&1 >/dev/null); then
            GITEA_READY=true
            break
        fi
        echo "      Warte auf Gitea-Verbindung... (${COUNT}/${MAX_RETRIES})"
        sleep 3
    done
    if [[ "${GITEA_READY}" != "true" ]]; then
        echo "      WARNUNG: git.orfel.de nach ${MAX_RETRIES} Versuchen nicht erreichbar."
        if [[ -n "${LAST_ERROR}" ]]; then
            echo "      Fehler-Details: ${LAST_ERROR}"
        fi
    fi
else
    echo "      WARNUNG: Kein VAULT_SYNC_TOKEN gefunden. Überspringe Remote-Sync."
fi

# 2. Vault klonen oder aktualisieren (idempotent)
mkdir -p "$(dirname "${VAULT_DIR}")"

if [[ -d "${VAULT_DIR}/.git" ]]; then
    echo "[1/3] Vault existiert bereits, aktualisiere Stand..."
    cd "${VAULT_DIR}"
    if [[ "${GITEA_READY}" == "true" ]]; then
        git remote set-url origin "${AUTH_REPO_URL}" 2>/dev/null || git remote add origin "${AUTH_REPO_URL}" 2>/dev/null || true
        if git fetch origin main 2>/dev/null; then
            git reset --hard origin/main 2>/dev/null || echo "      Reset nicht möglich, behalte lokalen Stand"
        else
            echo "      git fetch fehlgeschlagen, behalte lokalen Stand"
        fi
    else
        echo "      Keine Verbindung zu Gitea oder kein Token — behalte lokalen Stand"
    fi
else
    echo "[1/3] Initialisiere Vault aus Git-Repository..."
    rm -rf "${VAULT_DIR}"
    CLONED=false
    if [[ "${GITEA_READY}" == "true" ]]; then
        echo "      Klone existierenden Vault von git.orfel.de..."
        if git clone "${AUTH_REPO_URL}" "${VAULT_DIR}" 2>/dev/null; then
            CLONED=true
        fi
    fi

    if [[ "${CLONED}" != "true" ]]; then
        echo "      WARNUNG: git clone fehlgeschlagen oder nicht erreichbar. Erstelle leere Struktur..."
        mkdir -p "${VAULT_DIR}"
        for d in "00_Inbox" "00_Inbox/Verarbeitet" "00_Inbox/Problemfaelle" \
                 "01_Daily" "10_Wiki" "10_Wiki/Seiten" "20_Projekte" \
                 "90_Templates" "99_System" "99_System/Skripte" \
                 "99_System/Logs" "99_System/Cache"; do
            mkdir -p "${VAULT_DIR}/$d"
        done
        cd "${VAULT_DIR}"
        git init -b main 2>/dev/null || true
        git remote add origin "${AUTH_REPO_URL}" 2>/dev/null || true
    fi
fi

# 3. Git Config & Remote sicherstellen
if [[ -d "${VAULT_DIR}/.git" ]]; then
    cd "${VAULT_DIR}"
    git config user.name "Mind-o-Mat Server" 2>/dev/null || true
    git config user.email "mindomat@orfel.de" 2>/dev/null || true
    if [[ -n "${VAULT_SYNC_TOKEN}" ]]; then
        git remote set-url origin "${AUTH_REPO_URL}" 2>/dev/null || true
        echo "[2/3] Git Remote origin mit Authentifizierung eingerichtet"
    else
        echo "[2/3] Git Remote origin (ohne Token) eingerichtet"
    fi
fi

# 4. service.enabled sicherstellen
touch "${SVC_DIR}/service.enabled"

echo "==========================================="
echo " Mind-o-Mat Init completed"
echo "==========================================="
exit 0


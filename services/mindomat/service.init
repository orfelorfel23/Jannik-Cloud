#!/usr/bin/env bash
# Mind-o-Mat Service-Init (idempotent, wird von deploy_script.sh aufgerufen)
# Wird bei jedem Deploy ausgefuehrt, ueberspringt bereits initialisierte Teile

set -euo pipefail

SVC_DIR="$(cd "$(dirname "$0")" && pwd)"
VAULT_DIR="/mnt/Jannik-Cloud-Volume-01/mindomat-vault"
VAULT_REPO_URL="https://git.orfel.de/Jannik/Mind-o-Mat-Vault.git"

echo "==========================================="
echo " Mind-o-Mat Service Init"
echo "==========================================="

# Lese VAULT_SYNC_TOKEN aus .env falls vorhanden
VAULT_SYNC_TOKEN=""
if [[ -f "${SVC_DIR}/.env" ]]; then
    VAULT_SYNC_TOKEN=$(grep -E "^VAULT_SYNC_TOKEN=" "${SVC_DIR}/.env" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]"' || true)
fi

AUTH_REPO_URL="${VAULT_REPO_URL}"
if [[ -n "${VAULT_SYNC_TOKEN}" ]]; then
    AUTH_REPO_URL="https://${VAULT_SYNC_TOKEN}@git.orfel.de/Jannik/Mind-o-Mat-Vault.git"
fi

git config --global --add safe.directory "${VAULT_DIR}" 2>/dev/null || true

# 1. Vault klonen oder aktualisieren (idempotent)
if [[ ! -d "${VAULT_DIR}/.git" ]]; then
    echo "[1/4] Initialisiere Vault aus Git-Repository..."
    rm -rf "${VAULT_DIR}"
    mkdir -p "$(dirname "${VAULT_DIR}")"
    echo "      Klone existierenden Vault von ${VAULT_REPO_URL}..."
    git clone "${AUTH_REPO_URL}" "${VAULT_DIR}" || {
        echo "      WARNUNG: git clone fehlgeschlagen. Erstelle Fallback-Struktur..."
        mkdir -p "${VAULT_DIR}"
        for d in "00_Inbox" "00_Inbox/Verarbeitet" "00_Inbox/Problemfaelle" \
                 "01_Daily" "10_Wiki" "10_Wiki/Seiten" "20_Projekte" \
                 "90_Templates" "99_System" "99_System/Skripte" \
                 "99_System/Logs" "99_System/Cache"; do
            mkdir -p "${VAULT_DIR}/$d"
        done
        if [[ ! -d "${VAULT_DIR}/.git" ]]; then
            cd "${VAULT_DIR}"
            git init -b main
            git remote add origin "$AUTH_REPO_URL" || true
        fi
    }
    echo "      Vault bereit: $VAULT_DIR"
else
    echo "[1/4] Vault existiert bereits, aktualisiere mit origin/main..."
    cd "${VAULT_DIR}"
    git remote set-url origin "$AUTH_REPO_URL" 2>/dev/null || true
    git fetch origin main 2>/dev/null || true
    git pull --ff-only origin main 2>/dev/null || true
fi

# 2. Git Config & Remote sicherstellen
cd "${VAULT_DIR}"
if git rev-parse --is-inside-work-tree &>/dev/null; then
    git config user.name "Mind-o-Mat Server" 2>/dev/null || true
    git config user.email "mindomat@orfel.de" 2>/dev/null || true
    git remote set-url origin "$AUTH_REPO_URL" 2>/dev/null || git remote add origin "$AUTH_REPO_URL" 2>/dev/null || true
    echo "[2/4] Git Remote origin mit Authentifizierung eingerichtet"
fi

# 3. QMD-Collections einrichten (manuell, wenn gewuenscht)
if command -v qmd &>/dev/null && [[ -d "${VAULT_DIR}/00_Inbox" ]]; then
    echo "[3/4] QMD-Collections (falls qmd im PATH)..."
    if ! qmd collection list 2>/dev/null | grep -q inbox; then
        qmd collection add "${VAULT_DIR}/00_Inbox" --name inbox 2>/dev/null || true
        qmd collection add "${VAULT_DIR}/01_Daily" --name daily 2>/dev/null || true
        qmd collection add "${VAULT_DIR}/10_Wiki" --name wiki 2>/dev/null || true
        qmd collection add "${VAULT_DIR}/20_Projekte" --name projekte 2>/dev/null || true
    fi
else
    echo "[3/4] QMD-Collections werden im Container beim ersten Start eingerichtet"
fi

# 4. service.enabled sicherstellen
touch "${SVC_DIR}/service.enabled"

echo "==========================================="
echo " Mind-o-Mat Init completed"
echo "==========================================="

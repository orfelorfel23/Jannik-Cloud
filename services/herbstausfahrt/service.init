#!/usr/bin/env bash
# herbstausfahrt — service.init
# Clones / updates the Herbstausfahrt repository from Gitea into the volume.
# Called automatically by deploy_script.sh after Gitea has been started.
set -euo pipefail

REPO_URL="https://git.orfel.de/Orfel-HermesAI-Bot/Herbstausfahrt.git"
CONTENT_DIR="/mnt/Jannik-Cloud-Volume-01/herbstausfahrt/content"
NGINX_CONF="/mnt/Jannik-Cloud-Volume-01/herbstausfahrt/nginx.conf"

echo "[herbstausfahrt] Syncing content from Gitea..."

# Prevent dubious ownership errors when updating the repo
git config --global --add safe.directory "${CONTENT_DIR}" 2>/dev/null || true

# Retry loop — Gitea may need a few extra seconds after starting
MAX_RETRIES=10
COUNT=0
until git ls-remote "${REPO_URL}" &>/dev/null; do
    COUNT=$((COUNT + 1))
    if [[ ${COUNT} -ge ${MAX_RETRIES} ]]; then
        echo "[herbstausfahrt] ERROR: Cannot reach Gitea after ${MAX_RETRIES} attempts. Aborting."
        exit 1
    fi
    echo "[herbstausfahrt] Gitea not yet reachable, retrying in 5s... (${COUNT}/${MAX_RETRIES})"
    sleep 5
done

if [ -d "${CONTENT_DIR}/.git" ]; then
    echo "[herbstausfahrt] Repository already cloned — pulling latest changes..."
    cd "${CONTENT_DIR}"
    git fetch origin
    git reset --hard origin/main
else
    echo "[herbstausfahrt] Fresh clone of repository..."
    mkdir -p "$(dirname "${CONTENT_DIR}")"
    git clone "${REPO_URL}" "${CONTENT_DIR}"
fi

echo "[herbstausfahrt] Content sync complete."

# Write Nginx config (idempotent — safe to overwrite on every deploy)
mkdir -p "$(dirname "${NGINX_CONF}")"
cat > "${NGINX_CONF}" << 'NGINX'
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    location / {
        try_files $uri $uri/ =404;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|ico)$ {
        expires 1h;
        add_header Cache-Control "public, no-cache";
    }

    # Never cache JSON data (locations.json)
    location ~* \.json$ {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
NGINX

echo "[herbstausfahrt] Nginx config written."

#!/usr/bin/env bash
# erkw — service.init
# Generates .htpasswd for Modul 6 and cleans up obsolete directories.
# Called automatically by deploy_script.sh before starting the service.
set -euo pipefail

CONTENT_DIR="/mnt/Jannik-Cloud-Volume-01/erkw/content"
NGINX_CONF="/mnt/Jannik-Cloud-Volume-01/erkw/nginx.conf"
HTPASSWD_FILE="/mnt/Jannik-Cloud-Volume-01/erkw/.htpasswd"

# Cleanup legacy content volume & config if existing (now bundled in Docker image)
if [ -d "${CONTENT_DIR}" ] || [ -f "${NGINX_CONF}" ]; then
    echo "[erkw] Cleaning up obsolete legacy volume content..."
    rm -rf "${CONTENT_DIR}" "${NGINX_CONF}" 2>/dev/null || true
fi

# Load .env if it exists to get credentials for Modul 6
ENV_FILE="$(dirname "$0")/.env"
if [ -f "${ENV_FILE}" ]; then
    # export variables to make them available
    set -a
    source "${ENV_FILE}"
    set +a
fi

MODUL6_USER="${ERKW_MODUL6_USER:-test}"
MODUL6_PASS="${ERKW_MODUL6_PASS:-test}"

mkdir -p "$(dirname "${HTPASSWD_FILE}")"
echo "[erkw] Generating .htpasswd file for Modul 6 (user: ${MODUL6_USER})..."
if command -v openssl >/dev/null 2>&1; then
    HASH=$(openssl passwd -apr1 "${MODUL6_PASS}")
else
    HASH=$(docker run --rm nginx:alpine openssl passwd -apr1 "${MODUL6_PASS}" | tr -d '\r')
fi
echo "${MODUL6_USER}:${HASH}" > "${HTPASSWD_FILE}"

echo "[erkw] Init complete."

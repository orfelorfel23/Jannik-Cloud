#!/usr/bin/env bash
set -e

echo "[Backup] Starte MS SQL Backup Routine..."

# Prüfe, ob die .env Datei existiert
ENV_FILE="$(dirname "$0")/.env"
if [[ ! -f "${ENV_FILE}" ]]; then
    echo "[Backup] Keine .env Datei vorhanden. Überspringe Backup."
    exit 0
fi

# Lade Umgebungsvariablen aus der aktuellen .env Datei im Verzeichnis
source "${ENV_FILE}"

# Prüfe, ob der MSSQL Container läuft
if ! docker ps --format '{{.Names}}' | grep -q "^checkbox_mssql$"; then
    echo "[Backup] Container checkbox_mssql läuft nicht. Überspringe Backup."
    exit 0
fi

if [[ -z "${MSSQL_SA_PASSWORD:-}" || -z "${MSSQL_DB_NAME:-}" ]]; then
    echo "[Backup] MSSQL_SA_PASSWORD oder MSSQL_DB_NAME nicht konfiguriert. Überspringe Backup."
    exit 0
fi

VOLUME_BASE="/mnt/Jannik-Cloud-Volume-01/checkbox"
DATA_DIR="${VOLUME_BASE}/data"
BACKUP_DIR="${VOLUME_BASE}/backups"

mkdir -p "${BACKUP_DIR}"

# Prüfe, ob die Datenbank im SQL Server existiert
if ! docker exec checkbox_mssql /opt/mssql-tools18/bin/sqlcmd \
    -S localhost \
    -U sa \
    -P "${MSSQL_SA_PASSWORD}" \
    -C \
    -b \
    -Q "IF DB_ID('${MSSQL_DB_NAME}') IS NULL THROW 50000, 'DB does not exist', 1;" >/dev/null 2>&1; then
    echo "[Backup] Datenbank '${MSSQL_DB_NAME}' existiert noch nicht im SQL Server. Überspringe Backup."
    exit 0
fi

# Dateinamen generieren
DATE=$(date +%Y-%m-%d_%H-%M-%S)
CONTAINER_FILE="/var/opt/mssql/${MSSQL_DB_NAME}_${DATE}.bak"
TEMP_HOST_FILE="${DATA_DIR}/${MSSQL_DB_NAME}_${DATE}.bak"
FINAL_HOST_FILE="${BACKUP_DIR}/${MSSQL_DB_NAME}_${DATE}.bak"

echo "[Backup] Erstelle MS SQL Backup für Datenbank: ${MSSQL_DB_NAME}..."

# Führe SQLCMD im Container aus, um das Backup zu erstellen
# Express Edition unterstützt kein WITH COMPRESSION, daher komprimieren wir anschließend auf dem Host per gzip
docker exec checkbox_mssql /opt/mssql-tools18/bin/sqlcmd \
    -S localhost \
    -U sa \
    -P "${MSSQL_SA_PASSWORD}" \
    -C \
    -b \
    -Q "BACKUP DATABASE [${MSSQL_DB_NAME}] TO DISK = N'${CONTAINER_FILE}' WITH INIT, STATS = 10"

# Das Backup wurde nun im Container unter /var/opt/mssql angelegt.
# Da dies auf /mnt/.../data gemappt ist, liegt die Datei nun auf dem Host.
# Wir verschieben sie in den sauberen Backup-Ordner und komprimieren sie per gzip.
if [[ -f "${TEMP_HOST_FILE}" ]]; then
    mv "${TEMP_HOST_FILE}" "${FINAL_HOST_FILE}"
    gzip -f "${FINAL_HOST_FILE}"
    echo "[Backup] Erfolgreich komprimiert und gespeichert: ${FINAL_HOST_FILE}.gz"
else
    echo "[Backup] FEHLER: Backup-Datei wurde nach dem Ausführen nicht gefunden (${TEMP_HOST_FILE})"
    exit 1
fi

# Lösche alte Backups (behalte nur 7 Tage)
echo "[Backup] Bereinige alte Backups (älter als 7 Tage)..."
find "${BACKUP_DIR}" -name "*.bak*" -type f -mtime +7 -delete

echo "[Backup] Routine erfolgreich abgeschlossen."

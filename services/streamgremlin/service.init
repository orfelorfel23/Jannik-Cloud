#!/usr/bin/env bash
set -euo pipefail
SVC_DIR="$(cd "$(dirname "$0")" && pwd)"

mkdir -p "${SVC_DIR}/config" "${SVC_DIR}/sounds" "${SVC_DIR}/tts_cache"
chmod -R 777 "${SVC_DIR}/config" "${SVC_DIR}/sounds" "${SVC_DIR}/tts_cache" 2>/dev/null || true
echo "[streamgremlin] Initialized config and cache directories."
